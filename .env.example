# -----------------------------------
# Account Manager Environment Variables
#
# Python:
# We need to explicitly set the PYTHONPATH
# for Pylint so that it can find the account module
# in your local file system when running pylint, flake8, or Cornflakes
# from inside of VS Code. This is unrelated to actually
# running the Django app from Docker, which sets the
# PYTHONPATH in the Dockerfile.
# -----------------------------------
PAT=SET-ME-PLEASE

################################################################
# For local development
################################################################
SECRET_KEY=SET-ME-PLEASE

ENVIRONMENT=local
PYTHONPATH=./venv:./am
NODE_MAJOR=20
DEVELOPER_MODE=true


SMTP_SENDER=local.account.smarter.sh
SMTP_PASSWORD=SET-ME-PLEASE
SMTP_USERNAME=SET-ME-PLEASE
SMTP_FROM_EMAIL=no-reply@alpha.account.smarter.sh

ROOT_DOMAIN=smarter.sh

# AWS settings
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=SET-ME-PLEASE
AWS_PROFILE=SET-ME-PLEASE

NAMESPACE=smarter-account-alpha

# The database -> am_settings.mysql_*, as smarter's SMARTER_MYSQL_*. In Kubernetes it is Account
# Manager's own database and user on the shared MariaDB server of smarter's Helm chart
# (AM_MYSQL_HOST=smarter-mariadb.<smarter namespace>.svc.cluster.local). The defaults are
# docker-compose.yml's am-mariadb service, so local development needs none of these.
# AM_MYSQL_HOST=am-mariadb
# AM_MYSQL_PORT=3306
# AM_MYSQL_DATABASE=am
# AM_MYSQL_USER=am
# AM_MYSQL_PASSWORD=am
# AM_MYSQL_ROOT_USERNAME=root
# AM_MYSQL_ROOT_PASSWORD=am
# AM_DATABASE_READ_TIMEOUT=0
