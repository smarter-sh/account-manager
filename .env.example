# -----------------------------------
# Account Manager Environment Variables
#
# Python:
# We need to explicitly set the PYTHONPATH
# for Pylint so that it can find the account module
# in your local file system when running pylint, flake8, or Cornflakes
# from inside of VS Code. This is unrelated to actually
# running the Django app from Docker, which sets the
# PYTHONPATH in the Dockerfile.
# -----------------------------------
PAT=SET-ME-PLEASE

################################################################
# For local development
################################################################
SECRET_KEY=SET-ME-PLEASE
# see: https://fernetkeygen.com/
FERNET_ENCRYPTION_KEY=SET-ME-PLEASE

ENVIRONMENT=local
PYTHONPATH=./venv:./am
NODE_MAJOR=20
DEVELOPER_MODE=true


SMTP_SENDER=local.account.smarter.sh
SMTP_PASSWORD=SET-ME-PLEASE
SMTP_USERNAME=SET-ME-PLEASE
SMTP_FROM_EMAIL=no-reply@alpha.account.smarter.sh

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=SET-ME-PLEASE
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=SET-ME-PLEASE
SOCIAL_AUTH_GITHUB_KEY=SET-ME-PLEASE
SOCIAL_AUTH_GITHUB_SECRET=SET-ME-PLEASE
SOCIAL_AUTH_LINKEDIN_OAUTH2_KEY=SET-ME-PLEASE
SOCIAL_AUTH_LINKEDIN_OAUTH2_SECRET=SET-ME-PLEASE

MAILCHIMP_API_KEY=SET-ME-PLEASE
MAILCHIMP_LIST_ID=SET-ME-PLEASE

ROOT_DOMAIN=smarter.sh

# AWS settings
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=SET-ME-PLEASE
AWS_PROFILE=SET-ME-PLEASE

NAMESPACE=smarter-account-alpha
MYSQL_HOST=mysql.service.lawrencemcdaniel.com
MYSQL_PORT=3306
ACCOUNT_MYSQL_DATABASE=smarter_account_alpha
ACCOUNT_MYSQL_PASSWORD=SET-ME-PLEASE
ACCOUNT_MYSQL_USERNAME=smarter_account_alpha
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=SET-ME-PLEASE
