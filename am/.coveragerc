# coverage.py, for make coverage and the Tests workflow. Paths are relative to am/, the
# folder that manage.py is in (/home/am_user/am in the am-app container).
[run]
source =
    am/
omit =
    **/tests/*
    **/migrations/*
    # Django settings are configuration, not logic. Their only branches are a startup
    # diagnostics block that runs under gunicorn, not manage.py, and per-environment values.
    am/settings/*
    am/asgi.py
    am/wsgi.py
[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
